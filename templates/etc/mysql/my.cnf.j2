# {{ ansible_managed }}

{% for item in percona_server_etc_my_cnf %}

[{{ item.section }}]
{% for option in item.options %}
{% if option.name is defined %}
{% if option.value is defined %}
{{ option.name }} = {{ option.value }}
{% else %}
{{ option.name }}
{% endif %}
{% else %}

{% endif %}
{% endfor %}
{% endfor %}

{% if percona_server_etc_my_cnf_includedir is defined %}
!includedir {{ percona_server_etc_my_cnf_includedir }}
{% endif %}

{% if percona_server_use_legacy_auth_method %}
# Ansible variable percona_server_use_legacy_auth_method is true
[mysqld]
{% if percona_server_version_major is version('8.4', '>=') %}
{# default-authentication-plugin was removed in 8.4 (mysqld refuses to start with it), mysql_native_password is disabled by default #}
mysql_native_password = ON
authentication_policy = '*:mysql_native_password,,'
{% else %}
default-authentication-plugin = mysql_native_password
{% endif %}
{% endif %}
